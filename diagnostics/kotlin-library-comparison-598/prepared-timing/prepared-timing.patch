+fun verifyPortableUntimed598() {
+    val runtime = portableRuntime598() // Node targets reject the wrong runtime, before peer checks.
+    println("BEGIN598_UNTIMED\t$runtime\tKotlin2.4.21\tNO_PERFORMANCE_CLAIM")
+    var core = 0; var distinct = 0
+    fun <I : Any, D : Any> peer(adapter: PeerAdapter<I, D>) {
+        val integer = checkFamily598(adapter.id, "int", integerFixtures598, adapter::integer, adapter::integerText,
+            adapter::integerOperation) { actual, expected -> actual == expected }
+        val decimal = checkFamily598(adapter.id, "decimal", decimalFixtures598, adapter::decimal, adapter::decimalText,
+            adapter::decimalOperation) { actual, expected -> canonicalDecimal598(actual) == canonicalDecimal598(expected) }
+        core += integer.first + decimal.first; distinct += integer.second + decimal.second
+        println("NA598\t${adapter.id}\tdecimal-cohort\tValue-only oracle does not establish internal scale")
+        println("NA598\t${adapter.id}\tsignificant-HALF_EVEN\tNot exercised; no ambiguous mapping inferred")
+    }
+    peer(KroguAdapter); peer(IonsPinAdapter)
+    check(core == 128 && distinct in 0..32)
+    println("NA598\tJDK\t$runtime\tPublic java.math unavailable on this target; JVM entrypoint is separate")
+    println("NA598\tKBigNum0.0.20\t$runtime\tNo published JS/Wasm/macOS variant in pinned metadata")
+    println("COMPLETE598_UNTIMED_ONLY\tcore=$core\tdistinct=$distinct")
+}
