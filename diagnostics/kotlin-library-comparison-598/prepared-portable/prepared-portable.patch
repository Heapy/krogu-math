+package preparation598
+
+/** Source preparation only. All parsing/text/oracle observations are untimed. */
+private data class ExactFixture598(
+    val id: String, val a: String, val b: String,
+    val sum: String, val difference: String, val product: String, val square: String,
+)
+
+// Independent literal values, not outputs generated by either peer. Powers of ten
+// below are literal decimal representations, not a substitute peer arithmetic route.
+private val integerFixtures598 = listOf(
+    ExactFixture598("zero", "0", "0", "0", "0", "0", "0"),
+    ExactFixture598("signed", "-7", "3", "-4", "-10", "-21", "49"),
+    ExactFixture598("carry30", "1073741823", "1", "1073741824", "1073741822", "1073741823", "1152921502459363329"),
+    ExactFixture598("wide10", "100000000000000000000", "-10", "99999999999999999990", "100000000000000000010", "-1000000000000000000000", "1" + "0".repeat(40)),
+)
+private val decimalFixtures598 = listOf(
+    ExactFixture598("zero", "0.00", "-0.000", "0.000", "0.000", "0.00000", "0.0000"),
+    ExactFixture598("scale", "1.20", "3.400", "4.600", "-2.200", "4.08000", "1.4400"),
+    ExactFixture598("signed", "-1.25", "0.05", "-1.20", "-1.30", "-0.0625", "1.5625"),
+    ExactFixture598("wide10", "100000000000000000000.0", "-10.00", "99999999999999999990.00", "100000000000000000010.00", "-1000000000000000000000.000", "1" + "0".repeat(40) + ".00"),
+)
+
+/** String-only decimal-value observation, never a timed operation or scale oracle. */
+private fun canonicalDecimal598(text: String): Pair<String, Long> {
+    require(text.length in 1..10000)
+    val match = Regex("([+-]?)([0-9]+)(?:\\.([0-9]+))?(?:[eE]([+-]?[0-9]+))?").matchEntire(text)
+        ?: error("Unsupported public decimal observation: $text")
+    val fraction = match.groupValues[3]
+    val exponent = match.groupValues[4].ifEmpty { "0" }.toLong().also { require(it in -1000000L..1000000L) }
+    val coefficient = (match.groupValues[2] + fraction).trimStart('0')
+    if (coefficient.isEmpty()) return "0" to 0L
+    val digits = coefficient.trimEnd('0')
+    val scale = fraction.length.toLong() - exponent - (coefficient.length - digits.length)
+    return (if (match.groupValues[1] == "-") "-" else "") + digits to scale
+}
+
+private class Preservation598<V : Any>(private val observe: (V) -> String) {
+    private val retained = mutableListOf<Pair<V, String>>()
+    private fun verifyRetained() { for ((value, text) in retained) check(observe(value) == text) { "Earlier result observation changed" } }
+    fun call(a: V, b: V, operation: () -> V): V {
+        verifyRetained()
+        val aBefore = observe(a); val bBefore = observe(b)
+        val result = operation()
+        check(observe(a) == aBefore && observe(b) == bBefore) { "Input observation changed" }
+        verifyRetained()
+        retained += result to observe(result)
+        return result
+    }
+}
+
+private fun <V : Any> checkFamily598(
+    peer: String, family: String, fixtures: List<ExactFixture598>, parse: (String) -> V,
+    observe: (V) -> String, operation: (ExactOperation, V, V) -> V,
+    equivalent: (String, String) -> Boolean,
+): Pair<Int, Int> {
+    val preservation = Preservation598(observe) // Shared across varying input fixtures.
+    var core = 0; var distinct = 0
+    for (fixture in fixtures) {
+        val a = parse(fixture.a); val b = parse(fixture.b)
+        check(equivalent(observe(a), fixture.a) && equivalent(observe(b), fixture.b)) { "Parsed input value mismatch" }
+        fun repeated(id: String, left: V, right: V, op: ExactOperation, expected: String, isDistinct: Boolean = false) {
+            var previousText: String? = null
+            repeat(2) { repetition ->
+                val result = preservation.call(left, right) { operation(op, left, right) }
+                val actual = observe(result)
+                check(equivalent(actual, expected)) { "$peer/$family/${fixture.id}/$id: $actual versus $expected" }
+                check(previousText == null || previousText == actual) { "Repeated result observation changed" }
+                previousText = actual
+                println("CHECK598\t$peer\t$family/${fixture.id}/$id\t$repetition\t$actual\t$expected\tVALUE_ONLY")
+                if (isDistinct) distinct++ else core++
+            }
+        }
+        repeated("add", a, b, ExactOperation.ADD, fixture.sum)
+        repeated("subtract", a, b, ExactOperation.SUBTRACT, fixture.difference)
+        repeated("multiply", a, b, ExactOperation.MULTIPLY, fixture.product)
+        repeated("self-alias", a, a, ExactOperation.MULTIPLY, fixture.square)
+        val equal = parse(fixture.a)
+        if (equal === a) println("NA598\t$peer\t$family/${fixture.id}/distinct-equal\tParser reused identity")
+        else repeated("distinct-equal", a, equal, ExactOperation.MULTIPLY, fixture.square, isDistinct = true)
+    }
+    check(core == 32 && distinct in 0..8 && distinct % 2 == 0)
+    return core to distinct
+}
