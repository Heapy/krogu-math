+                BigDecimal absBase(MathContext mc) { return super.abs(mc); }
+                BigDecimal negateBase(MathContext mc) { return super.negate(mc); }
+            }
+            Explicit explicit = new Explicit();
+            BigDecimal throwing = new BigDecimal("0.00") {
